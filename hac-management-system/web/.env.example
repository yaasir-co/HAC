# Run npm run setup:local to generate local-only random credentials and start MySQL.
DATABASE_URL="mysql://hac:REPLACE_WITH_LOCAL_SECRET@127.0.0.1:3307/hac_dev"
APP_ORIGIN="http://localhost:3000"
UPLOAD_DIR="./uploads"
DEMO_MODE="true"
# Production must set DEMO_MODE=false and use a restricted dedicated database user.
HAC_STORAGE_PATH="./.local/storage"

# Optional persistent private fallback if the primary storage is not writable.
# HAC_STORAGE_FALLBACK_PATH="/owned/persistent/private/hac-fallback"
