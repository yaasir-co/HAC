{
  "name": "hac-intelligent-certification",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --use-env-proxy node_modules/next/dist/bin/next dev --hostname 0.0.0.0",
    "build": "npm run db:generate && next build && node scripts/prepare-standalone.mjs",
    "start": "node scripts/start-server.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "node scripts/generate-client.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:check": "npm run db:generate && tsx scripts/check-database.ts",
    "admin:create": "npm run db:generate && tsx scripts/create-initial-admin.ts",
    "db:seed": "tsx prisma/seed.ts",
    "setup:local": "node scripts/setup-local.mjs",
    "db:migrate:local": "node scripts/migrate-local.mjs",
    "backup:local": "node scripts/backup-local.mjs",
    "restore:local": "node scripts/restore-local.mjs",
    "test:integration": "node scripts/run-integration.mjs api",
    "test:ai-api": "node scripts/run-integration.mjs datasets",
    "test:e2e": "playwright test",
    "test:ai-pretrained": "node --use-env-proxy --import tsx tests/ai-pretrained.integration.ts",
    "db:restore:if-empty": "node scripts/restore-if-empty.mjs",
    "test:ai-training": "node scripts/run-integration.mjs training",
    "smoke:local": "node scripts/smoke-local.mjs",
    "test:restore": "node scripts/rehearse-restore.mjs"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tensorflow/tfjs": "^4.22.0",
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "next": "^16.1.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sharp": "0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@prisma/client-generator-js": "7.10.1",
    "@prisma/internals": "7.10.1",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "7.10.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
